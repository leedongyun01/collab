# 로컬 데이터베이스 설정 (Local DB Setting)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=1234
DB_NAME=collabmate
DB_PORT=3306

# 서버 설정 (Server Setting)
PORT=5000
HOST=localhost

# 보안 설정 (JWT)
JWT_SECRET=your_secret_key_here

# 허용할 프론트엔드 도메인 (CORS) - 로컬 테스트 시에는 http://localhost:3000 입력
CORS_ORIGIN=http://localhost:3000
